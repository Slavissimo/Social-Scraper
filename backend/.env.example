# YouTube Data API v3 key
# Get one free at: https://console.cloud.google.com/
# Enable "YouTube Data API v3" in your project, then create an API key.
# Free quota: 10,000 units/day (1 unit per commentThreads request)
# Tip: restrict the key in Google Cloud Console to YouTube Data API only.
YOUTUBE_API_KEY=your_api_key_here

# Frontend URL for CORS (default: http://localhost:5173)
# Set this when deploying so the backend accepts requests from your frontend domain.
# FRONTEND_URL=https://your-frontend.onrender.com
